# ---- Server ----
PORT=8787

# ---- Mint platform APIs ----
# OpenSea API v2 key. Required for OpenSea URL resolution.
# Get one at https://docs.opensea.io/reference/api-keys  (free, requires approval)
OPENSEA_API_KEY=

# Magic Eden / Reservoir. Public endpoints work unauthenticated but are heavily
# rate limited. A key raises the limit. https://docs.magiceden.io/
MAGICEDEN_API_KEY=

# ---- Indexers (optional, unlocks extra rule types) ----
# Etherscan V2 multichain key. Without it, "contract interaction" and
# "wallet age" rules report UNABLE TO VERIFY instead of guessing.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ---- RPC endpoints ----
# Defaults are public endpoints; replace with Alchemy/Infura/QuickNode for
# reliability. Comma-separate for failover.
RPC_ETHEREUM=
RPC_BASE=
RPC_POLYGON=
RPC_ARBITRUM=
RPC_OPTIMISM=
RPC_SEPOLIA=
